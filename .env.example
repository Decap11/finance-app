# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Never put a real key, password, or token in this file.

# Public -- these are compiled into the browser bundle by design.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Server-only. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely, so it is
# read only inside API route handlers under src/app/api/ and never in a component. Any
# variable added here without a NEXT_PUBLIC_ prefix stays on the server.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Comma-separated allow-list controlling who can reach the /developer platform console.
PLATFORM_ADMIN_EMAILS=you@example.com

# Optional. Canonical origin for Open Graph / share-preview URLs. Point it at the stable
# production domain -- a per-deployment *.vercel.app URL sits behind Deployment Protection
# and redirects link crawlers to SSO, so they never see the image.
NEXT_PUBLIC_SITE_URL=https://<your-domain>
